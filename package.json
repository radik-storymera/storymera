{
  "name": "storymera",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node server-dist/server/index.js",
    "dev": "vite --host localhost",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host localhost",
    "test": "node --experimental-strip-types --test tests/progress.test.ts",
    "server": "node --experimental-strip-types server/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "db:migrate": "node --experimental-strip-types server/migrate.ts",
    "test:api": "node --experimental-strip-types --test tests/api.test.ts",
    "db:start": "node server/mysql-local.mjs start",
    "db:stop": "node server/mysql-local.mjs stop",
    "db:backup": "node server/mysql-local.mjs backup",
    "test:secrets": "node tests/client-secrets.mjs",
    "db:verify-backup": "node server/verify-backup.mjs",
    "admin:grant": "node --experimental-strip-types server/grant-admin.ts",
    "content:import": "node --experimental-strip-types server/import-content.ts",
    "test:admin": "node --experimental-strip-types --test tests/admin.test.ts tests/media-history-trash.test.ts",
    "test:scene-editor": "node --experimental-strip-types --test tests/scene-editor.test.ts tests/admin-routes.test.ts",
    "test:admin-fixes": "node --experimental-strip-types --test tests/admin-fixes.test.ts",
    "test:reading": "node --experimental-strip-types --test tests/reading.test.ts tests/former-demo-scene.test.ts",
    "test:polls": "node --experimental-strip-types --test tests/linear-polls.test.ts",
    "test:access": "node --experimental-strip-types --test tests/guest-access-keys.test.ts",
    "test:billing": "node --experimental-strip-types --test tests/billing-plans.test.ts",
    "test:admin-users": "node --experimental-strip-types --test tests/admin-users.test.ts",
    "content:linearize": "node --experimental-strip-types server/migrate-linear-content.ts",
    "progress:reset-test-users": "node --experimental-strip-types server/reset-registered-progress.ts",
    "data:cleanup-test": "node --experimental-strip-types server/cleanup-test-data.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "file-type": "^22.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "~5.9.2",
    "vite": "^7.0.0"
  }
}
